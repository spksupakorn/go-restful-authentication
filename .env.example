# Application Configuration
APP_ENV=development
PORT=8080
HOST=0.0.0.0

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=user_management
MONGODB_TIMEOUT=10

# JWT Configuration
JWT_SECRET_KEY=your-256-bit-secret-key-change-this-in-production
JWT_ACCESS_TOKEN_DURATION=24
JWT_REFRESH_TOKEN_DURATION=168

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
